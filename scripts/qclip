#!/usr/bin/env bash
# qclip — copy from mac clipboard to the AmigaOS guest clipboard.device
#
# Reads mac clipboard via pbpaste (or stdin if a pipe is present) and
# stuffs it into the guest via the amiga_mcp devbench REST endpoint
# `/api/tools/clipboard/set`, which drives the bridge's CLIPSET path
# — clipboard_bridge.c wraps it in an IFF FTXT/CHRS form so native
# OS4 apps see it via Cmd-V / Edit > Paste.
#
# Usage:
#   qclip                    # pipe mac clipboard into guest
#   echo "hello" | qclip     # pipe stdin into guest
#   qclip "some text"        # pass literal text as argv
#
# Options:
#   --host HOST      devbench REST host (default: 127.0.0.1)
#   --port N         devbench REST port (default: 3000)
#   -h, --help
#
# Exits 0 on success, non-zero on error (network / bridge / no text).
set -euo pipefail

HOST="127.0.0.1"
PORT="3000"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --host) HOST="$2"; shift 2 ;;
        --port) PORT="$2"; shift 2 ;;
        -h|--help)
            sed -n '3,20p' "$0"
            exit 0 ;;
        *) break ;;
    esac
done

# Source text priority:
#   1. argv (rest of positional args, joined with spaces)
#   2. stdin if it's a pipe / redirect
#   3. mac clipboard via pbpaste
if [ $# -gt 0 ]; then
    TEXT="$*"
elif [ ! -t 0 ]; then
    TEXT="$(cat)"
else
    if ! command -v pbpaste >/dev/null; then
        echo "qclip: no argv, stdin is a tty, and pbpaste not found" >&2
        exit 2
    fi
    TEXT="$(pbpaste)"
fi

if [ -z "$TEXT" ]; then
    echo "qclip: nothing to copy (source is empty)" >&2
    exit 2
fi

# The bridge protocol frames CLIPSET as `CLIPSET|<text>\n` on a single
# line, so `\n` inside <text> terminates the frame early — and even if
# it didn't, sanitize_text() in clipboard_bridge.c would replace `\n`
# with space before writing to clipboard.device. Do the same folding
# here so the on-guest clipboard matches what qclip sent, and warn.
LINES=$(printf '%s' "$TEXT" | awk 'END{print NR}')
if [ "$LINES" -gt 1 ]; then
    echo "qclip: warning: input has $LINES lines; newlines are folded to spaces (bridge protocol is line-based, ~1024 char limit)" >&2
    TEXT="$(printf '%s' "$TEXT" | tr '\r\n' '  ')"
fi

# JSON-escape via python (avoids shell-quoting hell for arbitrary text).
JSON="$(python3 -c 'import sys,json; print(json.dumps({"text": sys.stdin.read()}))' <<<"$TEXT")"

RESP="$(curl -sS --fail --max-time 10 \
    -X POST "http://${HOST}:${PORT}/api/tools/clipboard/set" \
    -H 'Content-Type: application/json' \
    -d "$JSON")" || {
    echo "qclip: devbench call failed (is bridge up?)" >&2
    exit 3
}

STATUS="$(printf '%s' "$RESP" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("status") or d.get("error") or "?")')"
if [ "$STATUS" != "ok" ]; then
    echo "qclip: bridge returned: $RESP" >&2
    exit 3
fi

echo "qclip: sent ${#TEXT} bytes to guest clipboard" >&2
